<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio startup project for OSRIP. It contains no application code: F5 (or the
  green Start button) runs tools\start_osrip.py, which starts PostgreSQL, the FastAPI
  backend and the Vite frontend, waits for their readiness checks and then opens the
  website. Stop Debugging (Shift+F5) ends the backend and frontend it started.

  The launcher uses only the Python standard library, so any Python 3.11+ environment
  selected in Visual Studio can run it; the backend itself always runs in backend\.venv.
  See docs\WINDOWS_STARTUP.md.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{4f2b7c1e-8d3a-4b6e-9c21-5a7d0e3f9b12}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>start_osrip.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <!-- The repository root, so relative paths in the launcher output are familiar. -->
    <WorkingDirectory>..</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>OSRIP.Launcher</Name>
    <RootNamespace>OSRIP.Launcher</RootNamespace>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <CommandLineArguments>
    </CommandLineArguments>
    <EnableNativeCodeDebugging>False</EnableNativeCodeDebugging>
    <IsWindowsApplication>False</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="start_osrip.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ruff.toml" />
    <Content Include="..\docs\WINDOWS_STARTUP.md">
      <Link>WINDOWS_STARTUP.md</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Nothing to compile: the Build command succeeds without doing anything. -->
  <Target Name="CoreCompile" />
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>
