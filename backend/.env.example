OSRIP_ENVIRONMENT=development
OSRIP_DATABASE_URL=postgresql+psycopg://osrip:change-me@localhost:5432/osrip
OSRIP_CORS_ORIGINS=["http://localhost:5173"]

# Sessions. Keep Secure cookies (HTTPS) everywhere except plain-HTTP local development.
OSRIP_SESSION_COOKIE_SECURE=true
OSRIP_SESSION_ABSOLUTE_HOURS=8
OSRIP_SESSION_IDLE_MINUTES=30
# Keys the hash of client addresses stored for login throttling. Use a long random value.
OSRIP_CLIENT_HASH_KEY=change-me-to-a-long-random-value

# Login throttling and upload limits.
OSRIP_LOGIN_MAX_FAILURES=5
OSRIP_LOGIN_WINDOW_MINUTES=15
OSRIP_UPLOAD_MAX_BYTES=5242880

# Public address the browser uses (frontend origin; /api on the same origin).
# Used for e-mail links and Google/Microsoft redirect URIs. https:// in production.
OSRIP_PUBLIC_BASE_URL=http://localhost:5173

# E-mail: outbox (development: stored, readable at /dev/mail, never sent) | smtp | disabled
OSRIP_EMAIL_BACKEND=outbox
# OSRIP_SMTP_HOST=smtp.example.org
# OSRIP_SMTP_PORT=587
# OSRIP_SMTP_USERNAME=
# OSRIP_SMTP_PASSWORD=
# OSRIP_SMTP_FROM=OSRIP <no-reply@example.org>
# OSRIP_SMTP_STARTTLS=true
OSRIP_VERIFY_EMAIL_HOURS=24
OSRIP_RESET_PASSWORD_MINUTES=30
OSRIP_MAGIC_LINK_MINUTES=15
OSRIP_EMAIL_REQUESTS_PER_HOUR=5

# Google / Microsoft sign-in: offered only when BOTH id and secret are set (docs/INTEGRATIONS.md).
# OSRIP_GOOGLE_CLIENT_ID=
# OSRIP_GOOGLE_CLIENT_SECRET=
# OSRIP_MICROSOFT_CLIENT_ID=
# OSRIP_MICROSOFT_CLIENT_SECRET=
# OSRIP_MICROSOFT_TENANT=common

# Assistant (the answering model): anthropic (Messages API) | openai (Responses API) |
# gemini (Interactions API) | disabled. One provider answers each question; the fallback is
# used only when the primary fails before answering (timeout, network, rate limit, server
# error, daily limit or budget). Keys stay on the server; API access is billed by each
# provider separately (a ChatGPT, Gemini or Claude app subscription is NOT API access).
# ("fake" is a scripted test double used by automated tests; refused in production.)
OSRIP_ASSISTANT_PROVIDER=anthropic
# OSRIP_ASSISTANT_FALLBACK_PROVIDER=
# OSRIP_ANTHROPIC_API_KEY=
# Model ids: copy them from each provider's current model list; nothing assumes a "latest".
OSRIP_ASSISTANT_MODEL=claude-sonnet-5-5
# OSRIP_OPENAI_API_KEY=
# OSRIP_OPENAI_MODEL=
# OSRIP_GEMINI_API_KEY=
# OSRIP_GEMINI_MODEL=
OSRIP_ASSISTANT_TIMEOUT_SECONDS=30
OSRIP_ASSISTANT_MAX_PER_MINUTE=5
OSRIP_ASSISTANT_MAX_PER_HOUR=30
# Signed-in fair use: provider calls per account per day.
OSRIP_ASSISTANT_MAX_PER_DAY=100
OSRIP_ASSISTANT_MAX_MESSAGE_CHARS=1000

# Provider spending controls, counted per provider per day (UTC) from the provider_call log.
# Over the call limit a call is refused (and recorded), never sent.
OSRIP_PROVIDER_DAILY_CALL_LIMIT=500
# Optional daily budget per provider in USD; enforced only with prices configured below,
# taken from the provider's own price list (nothing is assumed). JSON, for example:
# OSRIP_PROVIDER_PRICES={"openai": {"input_per_mtok": 0, "output_per_mtok": 0, "per_search": 0}}
# OSRIP_PROVIDER_DAILY_BUDGET_USD=
# Google Search grounded results may be stored for at most two years (Gemini API terms);
# `python -m app.cli purge-grounded` removes older ones from stored replies.
OSRIP_GROUNDED_RETENTION_DAYS=730

# Web research (assistant tools web_search / read_web_page): brave (Brave Search API,
# OSRIP_RESEARCH_API_KEY) | openai (Responses API web_search; OSRIP_OPENAI_API_KEY and
# OSRIP_OPENAI_SEARCH_MODEL) | gemini (Grounding with Google Search; OSRIP_GEMINI_API_KEY and
# OSRIP_GEMINI_SEARCH_MODEL; shown verbatim apart from the answer, never given to a model)
# | disabled. Without a key the assistant says web search is unavailable. The fallback route
# is used only when the first fails, or for a cross-check the person asks for in Research
# mode. "fake", "fake-openai" and "fake-gemini" are scripted test routes, refused in production.
OSRIP_RESEARCH_PROVIDER=brave
# OSRIP_RESEARCH_FALLBACK_PROVIDER=
# OSRIP_RESEARCH_API_KEY=
# OSRIP_OPENAI_SEARCH_MODEL=
# OSRIP_GEMINI_SEARCH_MODEL=
OSRIP_RESEARCH_TIMEOUT_SECONDS=10
OSRIP_RESEARCH_MAX_SEARCHES_PER_ANSWER=3
OSRIP_RESEARCH_MAX_PAGES_PER_ANSWER=3
OSRIP_RESEARCH_PER_CLIENT_HOUR=60

# Background studies ("Create study"): identical studies on the same published data come
# from cache for this many hours; interrupted studies resume, up to the attempt limit.
OSRIP_RESEARCH_JOB_CACHE_HOURS=24
OSRIP_RESEARCH_JOB_MAX_ATTEMPTS=3
OSRIP_RESEARCH_JOB_STALE_MINUTES=15
# Page retrieval for studies with web sources: Firecrawl v2 (/scrape, /map), key kept on the
# server. Without a key, pages are read directly with the SSRF-safe fetcher. robots.txt is
# always checked by OSRIP itself, and only official hosts of the chosen scope are read.
# OSRIP_FIRECRAWL_API_KEY=
OSRIP_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
OSRIP_FIRECRAWL_TIMEOUT_SECONDS=45
# Limits per study (a study or schedule may lower them, never raise them).
OSRIP_CRAWL_MAX_PAGES=8
OSRIP_CRAWL_MAX_DEPTH=0
OSRIP_CRAWL_MAX_RUNTIME_SECONDS=300
OSRIP_CRAWL_MAX_CREDITS=60
OSRIP_CRAWL_MAX_PDF_PAGES=30
OSRIP_CRAWL_HOST_INTERVAL_SECONDS=2
# Optional: limit retrieval to these hosts instead of the official registry, e.g.
# OSRIP_CRAWL_ALLOWED_DOMAINS=["ncsi.gov.om","data.gov.om"]
# Scheduled reports run only when switched on here; each schedule also starts disabled, and
# schedules that call paid services need "allow paid runs".
OSRIP_SCHEDULED_REPORTS_ENABLED=false

# Speech (voice questions and spoken answers): azure (Azure AI Speech; key plus region,
# or a resource endpoint; server side only) | disabled. Without it the browser's own
# speech features are used where available. Audio is never stored.
OSRIP_SPEECH_PROVIDER=azure
# OSRIP_SPEECH_KEY=
# OSRIP_SPEECH_REGION=uaenorth
# OSRIP_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# Each persona's voice is set in the assistant profile (backend/app/knowledge/
# assistant_profile_v3.json, published as a new version): Al Mulhim ar-OM-AbdullahNeural and
# en-GB-RyanNeural (male), Ilham ar-OM-AyshaNeural and en-GB-SoniaNeural (female). The two
# settings below apply only to a profile without personas (versions 1 and 2).
OSRIP_SPEECH_VOICE_AR=ar-OM-AbdullahNeural
OSRIP_SPEECH_VOICE_EN=en-GB-RyanNeural
OSRIP_SPEECH_LOCALE_AR=ar-OM
OSRIP_SPEECH_LOCALE_EN=en-GB
OSRIP_SPEECH_MAX_SECONDS=60

# Real-time voice for "Talk" (LiveKit). OFF by default: without it the Talk workspace uses
# push-to-talk with the speech settings above and the chosen persona's still portrait.
# Needs a LiveKit project (cloud or self-hosted); keys stay on the server. The browser only
# receives a short-lived token for one room. The worker runs separately:
#   backend\.venv\Scripts\python.exe -m app.voice.agent dev
# Not yet tested against a real LiveKit project (docs/assistant-personas.md).
OSRIP_VOICE_REALTIME_ENABLED=false
# OSRIP_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# OSRIP_LIVEKIT_API_KEY=
# OSRIP_LIVEKIT_API_SECRET=
OSRIP_VOICE_TOKEN_MINUTES=10
OSRIP_VOICE_MAX_CALL_MINUTES=15
# Speech-to-text model for the agent (a LiveKit Inference model id, chosen after testing
# Arabic and English):
# OSRIP_VOICE_STT_MODEL=
# The agent's speaking voices are per persona and live in the assistant profile
# (personas[].voices.realtime, "provider/model:voice_id"; a man's voice for Al Mulhim, a
# woman's for Ilham), set by publishing a new profile version after listening tests.
# OSRIP_VOICE_TTS_MODEL_AR / _EN apply only to a profile without personas.
# Optional talking avatar (none chosen; see docs/avatar-providers.md). Needs its plugin
# package (livekit-agents[anam|liveavatar|bithuman|avatario]) and an account with the
# provider; each persona's avatar id is personas[].avatar.live_avatar_id in the profile.
# OSRIP_VOICE_AVATAR_PROVIDER=

# Guest allowance: successful AI answers for visitors without an account (both languages).
OSRIP_GUEST_ANSWER_LIMIT=5
OSRIP_GUEST_POLICY_VERSION=1
# Lifetime of the anonymous cookie and its server record after the last visit.
OSRIP_GUEST_SESSION_DAYS=90
# Abuse limits (per guest session; per client address, deliberately generous for shared networks).
OSRIP_GUEST_ASKS_PER_MINUTE=10
OSRIP_GUEST_ASKS_PER_CLIENT_HOUR=60
OSRIP_GUEST_SESSIONS_PER_CLIENT_HOUR=30

# SMS verification (register / sign in by phone). OFF by default. No production SMS
# provider has been selected yet, so no real adapter exists: set these only once one
# is chosen and implemented (docs/INTEGRATIONS.md, "SMS verification").
# "test" is the scripted provider for automated tests and local development (codes
# shown at /dev/mail, never sent); the API refuses to start with it in production.
OSRIP_SMS_ENABLED=false
OSRIP_SMS_PROVIDER=
# OSRIP_SMS_PROVIDER_API_KEY=
# OSRIP_SMS_PROVIDER_SERVICE_ID=
OSRIP_SMS_CODE_MINUTES=10
OSRIP_SMS_MAX_ATTEMPTS=5
OSRIP_SMS_RESEND_SECONDS=60
OSRIP_SMS_PER_NUMBER_HOUR=5
OSRIP_SMS_PER_CLIENT_HOUR=10
OSRIP_SMS_GLOBAL_HOUR=200
OSRIP_SMS_DEFAULT_COUNTRY=+968
