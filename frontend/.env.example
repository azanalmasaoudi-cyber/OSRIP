# Everything here is compiled into the public JavaScript: NEVER put a key, secret or
# password in a VITE_ variable. Model, search and speech keys belong in backend/.env.
#
# http (default): the OSRIP API through the Vite proxy. mock: offline in-browser
# synthetic fixtures only (no calculations, review cards or reports).
VITE_DATA_ADAPTER=http
# Same origin via the Vite dev proxy (vite.config.ts forwards /api to OSRIP_API_ORIGIN).
VITE_API_BASE_URL=/api/v1
# Basemap style for the Geography page (MapLibre GL JS). Default: OpenFreeMap "positron"
# (https://openfreemap.org, OpenStreetMap data, attribution shown on the map). Using it
# means accepting OpenFreeMap's terms (https://openfreemap.org/tos/), and viewers' browsers
# request tiles from it. Set to "none" to switch the basemap off; the table remains.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
