  <Import Project="$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets" />
  <!--
    Replaces the Node.js targets' Clean step, which runs "npm run clean" (no such script).
    Only files are deleted: folders synced by OneDrive carry the read-only attribute, which
    makes Windows refuse to remove them, and Vite reuses the empty folders.
  -->
  <Target Name="AfterClean">
    <ItemGroup>
      <OsripBuildOutput Include="$(MSBuildProjectDirectory)\dist\**\*" />
      <OsripBuildOutput Include="$(MSBuildProjectDirectory)\node_modules\.tmp\*.tsbuildinfo" />
    </ItemGroup>
    <Delete Files="@(OsripBuildOutput)" />
  </Target>
</Project>
