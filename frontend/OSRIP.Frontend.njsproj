<!--
  OSRIP frontend (React, TypeScript, Vite) for Visual Studio. Generated by
  tools\make_vs_projects.py: run it again after adding or removing files. TypeScript is
  checked by Visual Studio's language service against tsconfig.json (run "npm ci" first).
  Visual Studio never compiles TypeScript itself (TypeScriptCompileBlocked): Build runs
  "npm run build" (tsc -b, then the Vite production build into dist\), and Clean removes
  that output. Debugging this project alone runs the Vite dev server on port 5173 (the API
  must already run on 8010); F5 on OSRIP.Launcher starts everything.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <Name>OSRIP.Frontend</Name>
    <RootNamespace>OSRIP.Frontend</RootNamespace>
    <SaveNodeJsSettingsInProjectFile>True</SaveNodeJsSettingsInProjectFile>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <EnableTypeScript>true</EnableTypeScript>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{b82f4c17-5e9a-4d63-8c21-0f7a3e6d9b48}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>node_modules\vite\bin\vite.js</StartupFile>
    <ScriptArguments>--port 5173 --strictPort</ScriptArguments>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <ProjectTypeGuids>{3AF33F2E-1136-4D97-BBB7-1795711AC8B8};{9092AA53-FB77-4645-B42D-1CCCA6BD08BD}</ProjectTypeGuids>
    <StartWebBrowser>True</StartWebBrowser>
    <LaunchUrl>http://localhost:5173/</LaunchUrl>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' " />
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' " />
