# OSRIP API image. Build from the repository root:
#   docker build -f deploy/Dockerfile.api -t osrip-api .
# NOT BUILT OR RUN YET: Docker was not available in the development environment.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# A font with Arabic and Latin letters for PDF reports (DejaVu Sans; OSRIP_REPORT_FONT_PATH
# may name another TrueType font).
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core     && rm -rf /var/lib/apt/lists/*

# Exact versions from the tested environment, then the app itself without re-resolving.
COPY backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY backend/fixtures ./fixtures
# Run from source (/app): the seed command and SQL migrations locate files relative to it.
ENV PYTHONPATH=/app
RUN useradd --system --uid 10001 osrip
USER osrip

EXPOSE 8000
# One process per container; scale with OSRIP_WORKERS (measured: one worker queues
# requests under 10 concurrent clients; see docs/TEST_RESULTS.md).
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --workers ${OSRIP_WORKERS:-2}"]
