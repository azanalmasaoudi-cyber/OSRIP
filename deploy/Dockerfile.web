# OSRIP web image: builds the React app and serves it with Caddy, which also proxies
# /api to the API container and obtains HTTPS certificates automatically.
#   docker build -f deploy/Dockerfile.web -t osrip-web .
# NOT BUILT OR RUN YET: Docker was not available in the development environment.
FROM node:24-slim AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Same-origin API through Caddy; the basemap URL can be overridden (or "none").
ARG VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# MapTiler browser key (optional; empty = OpenFreeMap and open terrain). It ends up in the public
# JavaScript, so restrict it to the site's address in MapTiler ("Allowed HTTP origins").
ARG VITE_MAPTILER_KEY=
ENV VITE_DATA_ADAPTER=http VITE_API_BASE_URL=/api/v1 VITE_MAP_STYLE_URL=${VITE_MAP_STYLE_URL} \
    VITE_MAPTILER_KEY=${VITE_MAPTILER_KEY}
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
