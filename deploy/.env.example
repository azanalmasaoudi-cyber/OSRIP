# Copy to deploy/.env and replace every placeholder. Never commit deploy/.env.
# Generate secrets with, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"

#
# Server-side only: none of these values is ever sent to browsers. Only VITE_MAP_STYLE_URL
# (a public map style address) is built into the interface; never put a key in a VITE_ variable.

POSTGRES_PASSWORD=replace-with-a-long-random-password
# The requested public hostname. Its DNS record must be created by whoever manages the
# project.com zone (see docs/DEPLOYMENT.md); use a hosting-provided name until then.
OSRIP_DOMAIN=osrip.project.com

OSRIP_ENVIRONMENT=production
OSRIP_CORS_ORIGINS=["https://osrip.project.com"]
OSRIP_SESSION_COOKIE_SECURE=true
OSRIP_SESSION_ABSOLUTE_HOURS=8
OSRIP_SESSION_IDLE_MINUTES=30
OSRIP_CLIENT_HASH_KEY=replace-with-a-long-random-value
OSRIP_LOGIN_MAX_FAILURES=5
OSRIP_LOGIN_WINDOW_MINUTES=15
OSRIP_UPLOAD_MAX_BYTES=5242880
OSRIP_WORKERS=2

# Basemap: OpenFreeMap by default (accepting its terms: https://openfreemap.org/tos/),
# another MapLibre style URL, or "none" to switch the map off.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

OSRIP_PUBLIC_BASE_URL=https://osrip.project.com
OSRIP_EMAIL_BACKEND=smtp
OSRIP_SMTP_HOST=smtp.example.org
OSRIP_SMTP_PORT=587
OSRIP_SMTP_USERNAME=replace-me
OSRIP_SMTP_PASSWORD=replace-me
OSRIP_SMTP_FROM=OSRIP <no-reply@example.org>
# Changing a confirmed e-mail or verified phone: current password, or a sign-in
# within this many minutes for accounts without one.
OSRIP_REAUTH_MINUTES=10
# Leave empty to show "not configured" instead of a sign-in button.
OSRIP_GOOGLE_CLIENT_ID=
OSRIP_GOOGLE_CLIENT_SECRET=
OSRIP_MICROSOFT_CLIENT_ID=
OSRIP_MICROSOFT_CLIENT_SECRET=
OSRIP_MICROSOFT_TENANT=common
# Answering model: anthropic | openai | gemini (official APIs only; a consumer app
# subscription is not API access). Model ids from each provider's current model list.
# The fallback answers only when the primary fails. See docs/AI_PROVIDERS.md.
OSRIP_ASSISTANT_PROVIDER=anthropic
OSRIP_ASSISTANT_FALLBACK_PROVIDER=
OSRIP_ANTHROPIC_API_KEY=
OSRIP_ASSISTANT_MODEL=claude-sonnet-5-5
OSRIP_OPENAI_API_KEY=
OSRIP_OPENAI_MODEL=
OSRIP_OPENAI_SEARCH_MODEL=
OSRIP_GEMINI_API_KEY=
OSRIP_GEMINI_MODEL=
OSRIP_GEMINI_SEARCH_MODEL=
# Spending controls per provider per day (budget enforced only with OSRIP_PROVIDER_PRICES).
OSRIP_PROVIDER_DAILY_CALL_LIMIT=500
OSRIP_PROVIDER_DAILY_BUDGET_USD=

# Web research for the assistant: brave (Brave Search API key,
# https://api-dashboard.search.brave.com) | openai | gemini. The fallback route is used
# only when the first fails, or for a cross-check asked for in Research mode.
# Empty key: the assistant says web search is unavailable.
OSRIP_RESEARCH_PROVIDER=brave
OSRIP_RESEARCH_FALLBACK_PROVIDER=
OSRIP_RESEARCH_API_KEY=

# Voice: Azure AI Speech resource key and region (or OSRIP_SPEECH_ENDPOINT). Empty: the
# browser's own speech features are used where available, otherwise text only.
OSRIP_SPEECH_PROVIDER=azure
OSRIP_SPEECH_KEY=
OSRIP_SPEECH_REGION=
OSRIP_SPEECH_VOICE_AR=ar-OM-AbdullahNeural
OSRIP_SPEECH_VOICE_EN=en-GB-RyanNeural

# Nightly database dumps are kept this many days in the backups volume.
BACKUP_KEEP_DAYS=14

# SMS verification: keep disabled until the Twilio account, Verify service and Oman
# sender registration are complete and backend/scripts/sms_acceptance.py has passed with
# a real phone (docs/INTEGRATIONS.md). Never "test" here.
OSRIP_SMS_ENABLED=false
OSRIP_SMS_PROVIDER=twilio_verify
OSRIP_TWILIO_VERIFY_SERVICE_SID=
# An API key (preferred) ...
OSRIP_TWILIO_API_KEY_SID=
OSRIP_TWILIO_API_KEY_SECRET=
# ... or the account SID and auth token.
OSRIP_TWILIO_ACCOUNT_SID=
OSRIP_TWILIO_AUTH_TOKEN=
